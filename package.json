{
  "name": "mise-en-place",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test app/*.test.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "preflight:verify": "node --experimental-strip-types scripts/preflight-verify.mts",
    "print:verify": "node --experimental-strip-types scripts/print-verify.mts"
  },
  "dependencies": {
    "next": "16.4.5",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.22.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "download"
    }
  }
}
